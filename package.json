{
  "name": "borrowed-tomorrow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:workshop": "vite --host 0.0.0.0 --open \"/?dev=workshop\"",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep @ci",
    "test:e2e:ci:production": "BT_PRODUCTION=1 playwright test --grep @ci",
    "test:e2e:production": "BT_PRODUCTION=1 playwright test",
    "test:e2e:smoke": "playwright test --grep-invert @journey",
    "test:e2e:journeys": "playwright test --grep @journey",
    "art:one": "node scripts/export-chapter-one-art.mjs",
    "art:two": "node scripts/export-chapter-two-art.mjs",
    "art:three": "node scripts/export-chapter-three-art.mjs",
    "art:four": "node scripts/export-chapter-four-art.mjs",
    "art:five": "node scripts/export-chapter-five-art.mjs",
    "art:seven": "node scripts/export-chapter-seven-art.mjs",
    "art:six": "node scripts/export-chapter-six-art.mjs",
    "art:raster-maps": "node scripts/export-raster-maps.mjs",
    "art:raster-actors": "node scripts/export-raster-actors.mjs",
    "check:art-upload": "node scripts/check-art-upload.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
